{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Bearhawk photo",
  "type": "object",
  "required": ["id", "image", "thumbnail", "originalImage", "title", "caption", "whyUseful", "aircraftModel", "aircraftSerial", "builder", "section", "subsystem", "component", "category", "buildStage", "viewpoint", "tags", "sourceType", "sourceName", "sourceUrl", "sourceDocument", "sourcePage", "originalFilename", "originalPath", "originalCaption", "authorityLevel", "stockOrModified", "classification", "applicabilityNotes", "copyrightNotes", "rightsBasis", "reviewStatus", "reviewedBy", "reviewedAt", "reviewNotes", "evidence", "guideIds", "sha256", "width", "height"],
  "properties": {
    "id": {"type":"string", "pattern":"^[a-z0-9-]+$"},
    "image": {"type":"string", "pattern":"^assets/photos/[a-z0-9-]+/[^/]+$"},
    "thumbnail": {"type":"string", "pattern":"^assets/photos/[a-z0-9-]+/[^/]+$"},
    "originalImage": {"type":"string", "pattern":"^assets/photos/[a-z0-9-]+/[^/]+$"},
    "title": {"type":"string", "minLength":1},
    "caption": {"type":"string"},
    "whyUseful": {"type":"string", "minLength":20},
    "aircraftModel": {"enum":["Companion","Four","Patrol","Five","Unknown"]},
    "aircraftSerial": {"type":"string"},
    "builder": {"type":"string"},
    "section": {"type":"string", "minLength":1},
    "subsystem": {"type":"string", "minLength":1},
    "component": {"type":"string", "minLength":1},
    "category": {"type":"string", "pattern":"^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"},
    "buildStage": {"type":"string"},
    "viewpoint": {"type":"array", "items":{"type":"string"}, "uniqueItems":true},
    "tags": {"type":"array", "items":{"type":"string"}, "uniqueItems":true},
    "sourceType": {"enum":["Designer / Plans","Bearhawk Factory","Beartracks","Builder Manual","Builder Log","Bearhawk Forum","Photo Gallery","Other"]},
    "sourceName": {"type":"string", "minLength":1},
    "sourceUrl": {"type":"string", "pattern":"^(https?://[^\\s]+)?$"},
    "sourceDocument": {"type":"string"},
    "sourcePage": {"type":"string"},
    "originalFilename": {"type":"string", "minLength":1},
    "originalPath": {"type":"string", "minLength":1},
    "originalCaption": {"type":"string"},
    "authorityLevel": {"type":"integer", "minimum":1, "maximum":8},
    "stockOrModified": {"enum":["Stock","Modified","Unknown"]},
    "classification": {"enum":["SPECIFIED","STANDARD PRACTICE","COMMON BUILDER PRACTICE","INDIVIDUAL BUILDER SOLUTION","MODIFICATION","INFERENCE","UNKNOWN"]},
    "applicabilityNotes": {"type":"string", "minLength":10},
    "copyrightNotes": {"type":"string", "minLength":10},
    "rightsBasis": {"type":"string", "minLength":5},
    "reviewStatus": {"enum":["curated","approved"]},
    "humanReviewer": {"type":"string", "minLength":1},
    "reviewedBy": {"type":"string", "minLength":1},
    "reviewedAt": {"type":"string", "pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "reviewNotes": {"type":"string", "minLength":10},
    "evidence": {"type":"array", "minItems":1,"items":{"type":"object","required":["type","reference"],"properties":{"type":{"type":"string"},"reference":{"type":"string","minLength":1}}}},
    "guideIds": {"type":"array", "items":{"type":"string"}, "uniqueItems":true},
    "sha256": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "width": {"type":"integer", "minimum":1},
    "height": {"type":"integer", "minimum":1}
  },
  "allOf": [{"if":{"properties":{"reviewStatus":{"const":"approved"}}},"then":{"required":["humanReviewer"]}}]
}
